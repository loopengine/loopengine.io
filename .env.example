# PostHog — shared key/host across Better Data OSS + marketing sites; disable by leaving key empty.
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=

# Canonical domain + product slug sent with every analytics event (`site_id` is the hostname).
NEXT_PUBLIC_SITE_DOMAIN=loopengine.io
NEXT_PUBLIC_PRODUCT=loopengine
NEXT_PUBLIC_SITE_URL=https://loopengine.io

# GA4 measurement ID (G-…) for gtag('config') — from Data streams → Web stream details.
NEXT_PUBLIC_GA_MEASUREMENT_ID=
# Optional Google Tag ID (GT-…) for gtag.js loader if G-… returns 404 from googletagmanager.com.
NEXT_PUBLIC_GA_TAG_ID=
